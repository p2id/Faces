{
  "meta": {
    "project": "project-001",
    "date": "2026-11-09",
    "layer": "semantic"
  },
  "color": {
    "surface": {
      "canvas": "#FFFFFF",
      "subtle": "#F7F8FA",
      "raised": "#FFFFFF",
      "inverse": "#17202A"
    },
    "content": {
      "primary": "#17202A",
      "secondary": "#52606D",
      "muted": "#7B8794",
      "inverse": "#FFFFFF",
      "link": "#155EEF"
    },
    "border": {
      "default": "#D9E2EC",
      "strong": "#9FB3C8",
      "focus": "#155EEF"
    },
    "status": {
      "info": "#155EEF",
      "success": "#16794C",
      "warning": "#A15C00",
      "danger": "#C4320A",
      "infoSurface": "#EFF6FF",
      "successSurface": "#ECFDF3",
      "warningSurface": "#FFF7E6",
      "dangerSurface": "#FFF1F0"
    },
    "action": {
      "primary": "#155EEF",
      "primaryHover": "#004EEB",
      "primaryPressed": "#00359E",
      "secondary": "#FFFFFF",
      "danger": "#C4320A"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "loose": "1.7"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "thick": "2px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(23,32,42,0.08)",
    "md": "0 4px 12px rgba(23,32,42,0.12)",
    "lg": "0 12px 28px rgba(23,32,42,0.16)"
  },
  "opacity": {
    "disabled": "0.48",
    "muted": "0.72",
    "overlay": "0.64"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "standard": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2,0,0,1)",
      "enter": "cubic-bezier(0,0,0.2,1)",
      "exit": "cubic-bezier(0.4,0,1,1)"
    },
    "reduced": "0ms"
  },
  "layout": {
    "contentMax": "75rem",
    "measure": "72ch",
    "pagePadding": "1rem",
    "gridGap": "1.5rem",
    "navWidth": "15rem"
  },
  "size": {
    "controlHeight": "2.75rem",
    "iconSm": "1rem",
    "iconMd": "1.25rem",
    "iconLg": "1.5rem",
    "touchTarget": "2.75rem"
  },
  "zIndex": {
    "base": "0",
    "sticky": "10",
    "dropdown": "20",
    "toast": "30",
    "modal": "40"
  },
  "state": {
    "focusRing": "0 0 0 3px rgba(21,94,239,0.32)",
    "disabledOpacity": "{opacity.disabled}",
    "hoverTransition": "{motion.duration.fast} {motion.easing.standard}",
    "loadingOpacity": "0.64",
    "selectedSurface": "{color.status.infoSurface}",
    "errorBorder": "{color.status.danger}",
    "successBorder": "{color.status.success}"
  }
}