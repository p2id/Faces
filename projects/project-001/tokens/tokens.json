{
  "color": {
    "background": {
      "canvas": "#FFFFFF",
      "surface": "#F8FAFC",
      "raised": "#FFFFFF",
      "inverse": "#0F172A"
    },
    "content": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#64748B",
      "inverse": "#FFFFFF",
      "link": "#1D4ED8"
    },
    "border": {
      "default": "#CBD5E1",
      "subtle": "#E2E8F0",
      "strong": "#94A3B8"
    },
    "status": {
      "info": "#2563EB",
      "positive": "#15803D",
      "caution": "#A16207",
      "negative": "#B91C1C"
    },
    "action": {
      "primary": "#1D4ED8",
      "primaryHover": "#1E40AF",
      "primaryActive": "#1E3A8A"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.7"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "thick": "2px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgb(15 23 42 / 0.08)",
    "md": "0 4px 12px rgb(15 23 42 / 0.12)"
  },
  "opacity": {
    "disabled": 0.5,
    "muted": 0.7,
    "overlay": 0.6
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasis": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "reduced": "none"
  },
  "layout": {
    "contentMax": "75rem",
    "readingMax": "45rem",
    "gutter": "{spacing.4}",
    "gutterWide": "{spacing.8}",
    "columns": 12
  },
  "size": {
    "controlHeight": "2.75rem",
    "icon": "1.25rem",
    "focusRing": "0.1875rem",
    "headerHeight": "4rem"
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "dropdown": 20,
    "overlay": 30,
    "dialog": 40,
    "toast": 50
  },
  "state": {
    "hoverOpacity": 0.92,
    "pressedOpacity": 0.84,
    "disabledOpacity": "{opacity.disabled}",
    "focusRingColor": "{color.action.primary}",
    "focusRingWidth": "{size.focusRing}",
    "errorColor": "{color.status.negative}",
    "successColor": "{color.status.positive}"
  }
}