{
  "meta": {
    "project": "project-001",
    "date": "2026-10-28",
    "layer": "semantic"
  },
  "color": {
    "surface": {
      "canvas": "#FFFFFF",
      "raised": "#F8FAFC",
      "sunken": "#F1F5F9",
      "inverse": "#0F172A"
    },
    "content": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#64748B",
      "inverse": "#FFFFFF",
      "disabled": "#94A3B8"
    },
    "border": {
      "default": "#CBD5E1",
      "strong": "#94A3B8",
      "focus": "#2563EB",
      "disabled": "#E2E8F0"
    },
    "accent": {
      "default": "#2563EB",
      "hover": "#1D4ED8",
      "active": "#1E40AF",
      "subtle": "#DBEAFE"
    },
    "state": {
      "positive": "#15803D",
      "positiveSubtle": "#DCFCE7",
      "caution": "#A16207",
      "cautionSubtle": "#FEF3C7",
      "negative": "#B91C1C",
      "negativeSubtle": "#FEE2E2",
      "informative": "#0369A1",
      "informativeSubtle": "#E0F2FE"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "xxl": "2rem"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "thick": "2px",
    "style": "solid"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgb(15 23 42 / 0.08)",
    "md": "0 4px 12px rgb(15 23 42 / 0.12)",
    "lg": "0 12px 32px rgb(15 23 42 / 0.16)"
  },
  "opacity": {
    "disabled": 0.5,
    "muted": 0.7,
    "overlay": 0.6
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "reduced": "0ms"
  },
  "layout": {
    "contentMax": "1200px",
    "readingMax": "720px",
    "pagePadding": "{spacing.4}",
    "sectionGap": "{spacing.8}",
    "gridGap": "{spacing.4}"
  },
  "size": {
    "controlHeight": "44px",
    "icon": "20px",
    "avatar": "32px",
    "drawerWidth": "420px",
    "dialogWidth": "560px"
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "dropdown": 20,
    "drawer": 30,
    "dialog": 40,
    "toast": 50
  },
  "stateRelated": {
    "focusRing": "{border.thick} {color.border.focus}",
    "disabledOpacity": "{opacity.disabled}",
    "selectedBackground": "{color.accent.subtle}",
    "errorBorder": "{color.state.negative}",
    "successBorder": "{color.state.positive}",
    "loadingOpacity": "{opacity.muted}"
  }
}