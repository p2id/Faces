{
  "color": {
    "background": {
      "canvas": "#FFFFFF",
      "surface": "#F7F8FA",
      "elevated": "#FFFFFF",
      "inverse": "#17202A"
    },
    "text": {
      "primary": "#17202A",
      "secondary": "#52606D",
      "muted": "#697586",
      "inverse": "#FFFFFF",
      "link": "#155EEF"
    },
    "accent": {
      "primary": "#155EEF",
      "primaryHover": "#0F4AC6"
    },
    "feedback": {
      "info": "#155EEF",
      "success": "#16794C",
      "warning": "#A15C00",
      "error": "#C23030"
    },
    "state": {
      "hoverSurface": "#F0F4F8",
      "pressedSurface": "#E4E7EB",
      "selectedSurface": "#E8F0FF",
      "disabledSurface": "#F0F2F5",
      "disabledText": "#9AA5B1"
    },
    "border": {
      "subtle": "#D9E2EC",
      "strong": "#9FB3C8",
      "focus": "#155EEF"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.7"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "width": {
      "thin": "1px",
      "focus": "2px"
    },
    "style": "solid"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(23,32,42,0.08)",
    "md": "0 4px 12px rgba(23,32,42,0.12)"
  },
  "opacity": {
    "disabled": "0.56",
    "overlay": "0.48",
    "subtle": "0.72"
  },
  "motion": {
    "duration": {
      "fast": "100ms",
      "standard": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2,0,0,1)",
      "emphasized": "cubic-bezier(0.2,0,0,1.2)"
    },
    "reduced": "0ms"
  },
  "layout": {
    "containerMax": "1200px",
    "contentMax": "760px",
    "gutterCompact": "{spacing.4}",
    "gutterMedium": "{spacing.6}",
    "gutterWide": "{spacing.8}"
  },
  "size": {
    "controlHeight": "44px",
    "iconSm": "16px",
    "iconMd": "20px",
    "iconLg": "24px"
  },
  "zIndex": {
    "base": "0",
    "sticky": "10",
    "dropdown": "20",
    "modal": "30",
    "toast": "40"
  },
  "state": {
    "focusRing": "0 0 0 {border.width.focus} {color.border.focus}",
    "disabledOpacity": "{opacity.disabled}",
    "hoverTransition": "{motion.duration.fast} {motion.easing.standard}",
    "selectionBackground": "{color.state.selectedSurface}",
    "errorBorder": "{color.feedback.error}"
  }
}