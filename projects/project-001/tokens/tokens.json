{
  "meta": {
    "date": "2026-10-22",
    "project": "project-001"
  },
  "color": {
    "background": {
      "canvas": "#FFFFFF",
      "surface": "#F7F8FA",
      "raised": "#FFFFFF",
      "inverse": "#17202A"
    },
    "content": {
      "primary": "#17202A",
      "secondary": "#52606D",
      "muted": "#7B8794",
      "inverse": "#FFFFFF",
      "link": "#185ADB"
    },
    "border": {
      "default": "#CBD2D9",
      "strong": "#9AA5B1",
      "subtle": "#E4E7EB"
    },
    "action": {
      "primary": "#185ADB",
      "primaryHover": "{color.action.primary}",
      "primaryText": "#FFFFFF",
      "secondary": "#FFFFFF",
      "danger": "#C53030"
    },
    "status": {
      "info": "#2F80ED",
      "success": "#218739",
      "warning": "#B7791F",
      "critical": "#C53030",
      "neutral": "#7B8794"
    },
    "focus": {
      "ring": "#2F80ED"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "2xl": "2rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "loose": "1.7"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "heading": {
      "page": {
        "size": "{typography.fontSize.2xl}",
        "weight": "{typography.weight.semibold}",
        "lineHeight": "{typography.lineHeight.tight}"
      },
      "section": {
        "size": "{typography.fontSize.xl}",
        "weight": "{typography.weight.semibold}",
        "lineHeight": "{typography.lineHeight.tight}"
      }
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "width": {
      "thin": "1px",
      "thick": "2px"
    },
    "default": "{color.border.default}",
    "focus": "{color.focus.ring}"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(23,32,42,0.08)",
    "md": "0 4px 12px rgba(23,32,42,0.12)",
    "lg": "0 12px 32px rgba(23,32,42,0.16)"
  },
  "opacity": {
    "disabled": "0.48",
    "muted": "0.64",
    "overlay": "0.56"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2,0,0,1)",
      "emphasis": "cubic-bezier(0.2,0,0,1)"
    },
    "reduced": {
      "duration": "0ms"
    }
  },
  "layout": {
    "contentMax": "1200px",
    "readingMax": "720px",
    "gutter": "{spacing.4}",
    "sectionGap": "{spacing.8}",
    "gridGap": "{spacing.4}"
  },
  "size": {
    "controlHeight": "44px",
    "controlHeightCompact": "36px",
    "icon": "20px",
    "iconSmall": "16px",
    "touchTarget": "44px"
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "dropdown": 20,
    "drawer": 30,
    "modal": 40,
    "toast": 50,
    "tooltip": 60
  },
  "state": {
    "hover": {
      "surface": "{color.background.surface}",
      "opacity": "1"
    },
    "pressed": {
      "opacity": "0.88"
    },
    "disabled": {
      "opacity": "{opacity.disabled}",
      "content": "{color.content.muted}"
    },
    "focusVisible": {
      "outlineColor": "{color.focus.ring}",
      "outlineWidth": "{border.width.thick}",
      "outlineOffset": "2px"
    },
    "invalid": {
      "borderColor": "{color.status.critical}",
      "contentColor": "{color.status.critical}"
    },
    "selected": {
      "surface": "#E8F0FE",
      "borderColor": "{color.action.primary}"
    }
  }
}