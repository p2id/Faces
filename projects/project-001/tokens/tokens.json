  "semantic": {
    "pageBackground": "{color.background.canvas}",
    "panelBackground": "{color.background.surface}",
    "bodyText": "{color.text.primary}",
    "secondaryText": "{color.text.secondary}",
    "interactiveText": "{color.text.link}",
    "focus": "{state.focusRing}",
    "controlHeight": "{size.controlHeight}",
    "contentWidth": "{layout.contentMax}"
