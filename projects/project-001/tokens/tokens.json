{
  "meta": {
    "projectId": "project-001",
    "date": "2026-11-02",
    "layer": "semantic"
  },
  "color": {
    "background": {
      "canvas": "#FFFFFF",
      "surface": "#F8FAFC",
      "raised": "#FFFFFF",
      "inverse": "#0F172A"
    },
    "text": {
      "primary": "#0F172A",
