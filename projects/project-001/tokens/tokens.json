{
  "meta": {
    "project": "project-001",
    "date": "2026-11-13"
  },
  "color": {
    "neutral": {
      "0": "#ffffff",
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "300": "#cbd5e1",
      "500": "#64748b",
      "600": "#475569",
      "900": "#0f172a"
    },
    "blue": {
      "50": "#eff6ff",
      "600": "#2563eb",
      "700": "#1d4ed8"
    },
    "surface": {
      "canvas": "{color.neutral.0}",
      "raised": "{color.neutral.50}",
      "subtle": "{color.neutral.100}",
      "inverse": "{color.neutral.900}"
    },
    "text": {
      "primary": "{color.neutral.900}",
      "secondary": "{color.neutral.600}",
      "muted": "{color.neutral.500}",
      "inverse": "{color.neutral.0}"
    },
    "border": {
      "default": "{color.neutral.300}",
      "strong": "{color.neutral.500}",
      "focus": "{color.blue.600}"
    },
    "accent": {
      "default": "{color.blue.600}",
      "hover": "{color.blue.700}",
      "subtle": "{color.blue.50}"
    },
    "success": {
      "text": "#166534",
      "surface": "#f0fdf4",
      "border": "#86efac"
    },
    "warning": {
      "text": "#854d0e",
      "surface": "#fefce8",
      "border": "#fde047"
    },
    "danger": {
      "text": "#b91c1c",
      "surface": "#fef2f2",
      "border": "#fca5a5"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "thick": "2px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(15,23,42,0.08)",
    "md": "0 4px 12px rgba(15,23,42,0.12)"
  },
  "opacity": {
    "disabled": 0.5,
    "muted": 0.7,
    "overlay": 0.6
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2,0,0,1)"
    },
    "reduced": "0ms"
  },
  "layout": {
    "contentMax": "1200px",
    "wideMax": "1280px",
    "pagePadding": "{spacing.4}",
    "columnGap": "{spacing.6}",
    "sectionGap": "{spacing.8}"
  },
  "size": {
    "controlHeight": "44px",
    "icon": "20px",
    "iconSmall": "16px",
    "focusRing": "3px"
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "dropdown": 20,
    "overlay": 30,
    "dialog": 40,
    "toast": 50
  },
  "state": {
    "focusRing": "0 0 0 {size.focusRing} {color.border.focus}",
    "disabledOpacity": "{opacity.disabled}",
    "loadingOpacity": "{opacity.muted}",
    "selectedSurface": "{color.accent.subtle}",
    "errorSurface": "{color.danger.surface}",
    "successSurface": "{color.success.surface}",
    "warningSurface": "{color.warning.surface}"
  }
}