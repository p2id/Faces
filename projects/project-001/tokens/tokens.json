{
  "color": {
    "surface": {
      "canvas": "#FFFFFF",
      "raised": "#F8FAFC",
      "inverse": "#0F172A"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#64748B",
      "inverse": "#FFFFFF",
      "link": "#2563EB"
    },
    "border": {
      "default": "#CBD5E1",
      "subtle": "#E2E8F0",
      "strong": "#94A3B8"
    },
    "accent": {
      "default": "#2563EB",
      "hover": "#1D4ED8",
      "pressed": "#1E40AF"
    },
    "state": {
      "info": "#2563EB",
      "success": "#15803D",
      "warning": "#A16207",
      "error": "#B91C1C",
      "disabled": "#94A3B8"
    },
    "focus": "#7C3AED"
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.7"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "thick": "2px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgb(15 23 42 / 0.08)",
    "md": "0 4px 12px rgb(15 23 42 / 0.12)",
    "lg": "0 12px 32px rgb(15 23 42 / 0.16)"
  },
  "opacity": {
    "disabled": "0.5",
    "muted": "0.7",
    "overlay": "0.6"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reduced": "none"
  },
  "layout": {
    "contentMax": "1200px",
    "readingMax": "80ch",
    "gutter": "{spacing.4}",
    "sectionGap": "{spacing.8}"
  },
  "size": {
    "controlHeight": "2.75rem",
    "compactControlHeight": "2.25rem",
    "icon": "1.25rem",
    "touchTarget": "2.75rem",
    "avatar": "2rem"
  },
  "zIndex": {
    "base": "0",
    "sticky": "10",
    "dropdown": "20",
    "overlay": "30",
    "modal": "40",
    "toast": "50"
  },
  "state": {
    "focusRing": "0 0 0 3px rgb(124 58 237 / 0.35)",
    "disabledOpacity": "{opacity.disabled}",
    "hoverTransition": "{motion.duration.fast} {motion.easing.standard}",
    "loadingOpacity": "{opacity.muted}",
    "errorBorder": "{color.state.error}",
    "successBorder": "{color.state.success}"
  }
}