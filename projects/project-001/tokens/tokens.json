{
  "meta": {
    "project": "project-001",
    "date": "2026-10-20"
  },
  "color": {
    "background": {
      "canvas": "#FFFFFF",
      "surface": "#F8FAFC",
      "inverse": "#0F172A"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
