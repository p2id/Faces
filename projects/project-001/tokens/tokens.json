{
  "color": {
    "background": {
      "canvas": "#ffffff",
      "surface": "#f7f8fa",
      "raised": "#ffffff",
      "inverse": "#17202a"
    },
    "content": {
      "primary": "#17202a",
      "secondary": "#52606d",
      "muted": "#7b8794",
      "inverse": "#ffffff",
      "link": "#185abc"
    },
    "border": {
      "default": "#d9e2ec",
      "strong": "#9fb3c8",
      "focus": "#185abc"
    },
    "status": {
      "info": "#185abc",
      "success": "#16794c",
      "warning": "#9a6700",
      "error": "#b42318"
    },
    "action": {
      "primary": "#185abc",
      "primaryHover": "#124a96",
      "danger": "#b42318"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "thick": "2px",
    "style": "solid"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgb(23 32 42 / 0.08)",
    "md": "0 4px 12px rgb(23 32 42 / 0.12)"
  },
  "opacity": {
    "disabled": 0.5,
    "muted": 0.72,
    "overlay": 0.6
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 0.2)"
    },
    "reduced": "0ms"
  },
  "layout": {
    "contentMax": "80rem",
    "textMax": "42rem",
    "gutterSmall": "$spacing.4",
    "gutterMedium": "$spacing.6",
    "gutterLarge": "$spacing.8",
    "gridGap": "$spacing.4"
  },
  "size": {
    "controlHeight": "2.75rem",
    "icon": "1.25rem",
    "touchTarget": "2.75rem",
    "sidebar": "15rem"
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "dropdown": 20,
    "overlay": 30,
    "modal": 40,
    "toast": 50
  },
  "state": {
    "focusRing": "0 0 0 3px rgb(24 90 188 / 0.3)",
    "disabledOpacity": "$opacity.disabled",
    "hoverTransition": "all $motion.duration.fast $motion.easing.standard",
    "loadingOpacity": "$opacity.muted",
    "selectedBackground": "#eaf2ff",
    "errorBorder": "$color.status.error",
    "successBorder": "$color.status.success"
  }
}