    "focusRing": "0 0 0 3px #93C5FD",
    "selectedBackground": "#DBEAFE",
    "disabledText": "#64748B",
    "errorBorder": "#B91C1C",
    "successBackground": "#DCFCE7",
    "warningBackground": "#FEF3C7"
