{
  "meta": {
    "date": "2026-11-23",
    "projectId": "project-001",
    "version": "1.0.0"
  },
  "color": {
    "background": {
      "canvas": "#FFFFFF",
      "surface": "#F8FAFC",
      "raised": "#FFFFFF",
      "inverse": "#0F172A"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#64748B",
      "inverse": "#FFFFFF",
      "link": "#1D4ED8"
    },
    "border": {
      "default": "#CBD5E1",
      "subtle": "#E2E8F0",
      "strong": "#94A3B8",
      "focus": "#2563EB"
    },
    "status": {
      "info": "#2563EB",
      "positive": "#15803D",
      "caution": "#A16207",
      "negative": "#B91C1C"
    },
    "action": {
      "primary": "#1D4ED8",
      "primaryHover": "#1E40AF",
      "danger": "#B91C1C",
      "dangerHover": "#991B1B"
    },
    "state": {
      "hover": "#F1F5F9",
      "selected": "#DBEAFE",
      "disabled": "#F1F5F9",
      "invalid": "#FEF2F2",
      "success": "#F0FDF4"
    }
  },
  "typography": {
    "family": {
      "sans": "system-ui, sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.7"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "medium": "2px",
    "focus": "2px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgb(15 23 42 / 0.08)",
    "md": "0 4px 12px rgb(15 23 42 / 0.12)",
    "lg": "0 12px 32px rgb(15 23 42 / 0.16)"
  },
  "opacity": {
    "disabled": "0.5",
    "muted": "0.7",
    "overlay": "0.6"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "reduced": "0ms"
  },
  "layout": {
    "contentMax": "75rem",
    "readingMax": "45rem",
    "gutterXs": "{spacing.4}",
    "gutterMd": "{spacing.6}",
    "gutterLg": "{spacing.8}",
    "gridGap": "{spacing.6}"
  },
  "size": {
    "controlSm": "2rem",
    "controlMd": "2.75rem",
    "controlLg": "3.25rem",
    "iconSm": "1rem",
    "iconMd": "1.25rem",
    "iconLg": "1.5rem"
  },
  "zIndex": {
    "base": "0",
    "sticky": "10",
    "dropdown": "100",
    "overlay": "200",
    "toast": "300",
    "tooltip": "400"
  },
  "state": {
    "focusRing": "0 0 0 {border.focus} {color.border.focus}",
    "disabledOpacity": "{opacity.disabled}",
    "loadingOpacity": "{opacity.muted}",
    "selectedBackground": "{color.state.selected}",
    "invalidBackground": "{color.state.invalid}",
    "hoverBackground": "{color.state.hover}"
  }
}