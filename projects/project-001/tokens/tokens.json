{
  "meta": {
    "projectId": "project-001",
    "date": "2026-10-31",
    "layer": "semantic"
  },
  "color": {
    "background": {
      "canvas": "#FFFFFF",
      "surface": "#F8FAFC",
      "raised": "#FFFFFF",
      "inverse": "#0F172A"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#64748B",
      "inverse": "#FFFFFF",
      "link": "#1D4ED8"
    },
    "brand": {
      "primary": "#1D4ED8",
      "hover": "#1E40AF",
      "pressed": "#1E3A8A"
    },
    "state": {
      "info": "#2563EB",
      "success": "#15803D",
      "warning": "#A16207",
      "error": "#B91C1C",
      "disabled": "#94A3B8"
    },
    "border": {
      "default": "#CBD5E1",
      "subtle": "#E2E8F0",
      "strong": "#64748B",
      "focus": "#1D4ED8"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "display": "2rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.7"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "border": {
    "thin": "1px",
    "medium": "2px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgb(15 23 42 / 0.08)",
    "md": "0 4px 12px rgb(15 23 42 / 0.12)",
    "lg": "0 12px 32px rgb(15 23 42 / 0.16)"
  },
  "opacity": {
    "disabled": "0.56",
    "muted": "0.72",
    "overlay": "0.48"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "entrance": "cubic-bezier(0, 0, 0.2, 1)"
    },
    "reduced": "0ms"
  },
  "layout": {
    "contentMax": "75rem",
    "readingMax": "45rem",
    "gutterMobile": "{spacing.4}",
    "gutterDesktop": "{spacing.6}",
    "navigationWidth": "16rem",
    "navigationWidthCompact": "4rem"
  },
  "size": {
    "controlHeight": "2.75rem",
    "controlHeightSmall": "2.25rem",
    "icon": "1.25rem",
    "iconSmall": "1rem",
    "touchTarget": "2.75rem",
    "statusDot": "0.5rem"
  },
  "zIndex": {
    "base": "0",
    "sticky": "10",
    "dropdown": "20",
    "toast": "30",
    "modal": "40",
    "tooltip": "50"
  },
  "state": {
    "focusRing": "0 0 0 3px rgb(29 78 216 / 0.32)",
    "disabledOpacity": "{opacity.disabled}",
    "hoverTransition": "{motion.duration.fast} {motion.easing.standard}",
    "selectedBorder": "{color.brand.primary}",
    "invalidBorder": "{color.state.error}",
    "validBorder": "{color.state.success}",
    "loadingOpacity": "{opacity.muted}"
  }
}